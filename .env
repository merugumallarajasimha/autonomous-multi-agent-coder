# API Keys for cloud LLM providers (optional - for fallback when Ollama unavailable)
# Get keys from: https://openrouter.ai/keys, https://console.cloud.google.com/, https://console.groq.com/keys

OPENROUTER_API_KEY=your_openrouter_key_here
GOOGLE_API_KEY=your_google_key_here
GROQ_API_KEY=your_groq_key_here


# Ollama (local) - no key needed, just run: ollama serve
# Models used: qwen2.5:3b, qwen2.5-coder:7b
# Pull with: ollama pull qwen2.5:3b && ollama pull qwen2.5-coder:7b